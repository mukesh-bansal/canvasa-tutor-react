{
  "name": "@canvasa/tutor-react",
  "version": "0.1.1",
  "description": "Embeddable AI Tutor — React components + API client. Host-themed via CSS variables.",
  "type": "module",
  "main": "./dist/tutor-react.js",
  "module": "./dist/tutor-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tutor-react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "axios": ">=1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "keywords": ["ai-tutor", "physics", "education", "canvasa"],
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canvasa/tutor-react.git"
  }
}
